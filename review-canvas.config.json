{
  "$schema": "./review-canvas.config.schema.json",
  "storybooks": [
    {
      "id": "shop",
      "label": "サンプルショップ",
      "build": "pnpm --dir examples/sample-storybook run build-storybook --test",
      "outDir": "examples/sample-storybook/storybook-static",
      "widths": [375, 768, 1280],
      "defaultWidth": 375,
      "baseHeight": 812
    },
    {
      "id": "app",
      "label": "review canvas",
      "build": "pnpm exec storybook build --quiet --test",
      "outDir": "storybook-static",
      "widths": [1280, 1440],
      "defaultWidth": 1280,
      "baseHeight": 800
    }
  ],
  "excludeTitlePrefixes": ["Components/"],
  "watchPaths": [
    "examples/sample-storybook/",
    "src/",
    ".storybook/",
    "review-canvas.config.json"
  ]
}
