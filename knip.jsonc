{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // 同じファイルの中で使っている export は数えない（テストから読むために export した定数など）
  "ignoreExportsUsedInFile": true,
  // 意味の違う名前を同じ値に付けることがある（既定値に名前を付ける、など）
  "exclude": ["duplicates"],
  // サンプルの Storybook は使う側のアプリの見本で、このリポジトリのコードからは読まない
  "ignoreWorkspaces": ["examples/sample-storybook"],
  "workspaces": {
    ".": {
      "entry": [
        "src/features/review/bridge/bridge-main.ts",
        "api/handler/api/entrypoint/{cli,lambda,local}/*.ts",
        "bin/*.mjs",
        "scripts/*.mjs",
        ".claude/hooks/*.mjs",
        "eslint.config.base.mjs",
      ],
      "project": [
        "{api,src,bin,eslint-rules,scripts,.claude/hooks}/**/*.{ts,tsx,mjs}",
      ],
      // 型を使う lint ルールのテスト（RuleTester）が、ファイル名と tsconfig を通して読む（import はされない）
      "ignore": ["eslint-rules/fixtures/**"],
      // CDK（NodejsFunction）が Lambda をバンドルするときに、パッケージの根で `pnpm exec esbuild` として動かす（infra/lib/review-canvas.ts の projectRoot）
      "ignoreDependencies": ["esbuild"],
      // CI の「Synth embedded」が infra/node_modules の esbuild-register を絶対パスで読む（infra の依存）
      "github-actions": false,
    },
    "infra": {
      // scripts/annotate-screen.ts は、Issue・PR に貼る画像を作る開発の道具（pnpm --dir infra run annotate-screen。スキル dev-write-issue）
      "entry": [
        "bin/review-canvas.ts",
        "test/embedded-app.ts",
        "scripts/annotate-screen.ts",
      ],
      "project": ["**/*.ts"],
      // infra は設定の形（api/infrastructure/config/*.ts。zod の定義）を相対パスで読むので、動かすのに zod が要る。
      // infra/ の中のファイルは zod を直に import しないため knip には使っていないと見えるが、依存として書いておく
      "ignoreDependencies": ["zod"],
    },
  },
}
