SERVICE_NAME=review-canvas
LOG_LEVEL=INFO
STAGE_NAME=LOCAL
# 画面と API を同じオリジンで配るため、CORS は付けない（別のオリジンから呼ぶときだけカンマ区切りで入れる）
ALLOW_ORIGINS=

# API のトークンの検証。dev=擬似ログインの署名なし JWT（LOCAL だけで使える。画面も擬似ログインになる）/ auth0=Auth0 のアクセストークン検証
AUTH_MODE=dev
# auth0 のときだけ読む。発行元（iss）は https:// で始まり / で終わる形（Auth0 のトークンの iss と完全一致させる）。宛先（aud）は API の識別子
# AUTH0_ISSUER=https://your-tenant.example.com/
# AUTH0_AUDIENCE=https://review-canvas.example.com/api
# 使ってよい人（確かめ済みのメールアドレスのドメイン・メールアドレス。カンマ区切り）。AUTH_MODE=auth0 のときだけ読む
# ALLOWED_EMAIL_DOMAINS=*  （* はどのドメインも通す。確かめ済みのメールアドレスは求める）
# ALLOWED_EMAILS=
# 人の代わりに API を呼んでよい client（AI・CI の Machine to Machine Application。`<Client ID>:<表示名>` のカンマ区切り。docs/auth0.md）。未設定ならだれも通さない
# AUTH0_M2M_CLIENTS=AbCdEf0123456789AbCdEf0123456789:fixer

# いま配る Storybook のブランチとコミット。未設定なら起動時に git から読む（?branch= で別のブランチのコメントも見られる）
# REVIEW_BRANCH=
# REVIEW_COMMIT=

# 並べる Storybook の設定ファイル（相対パスはこのリポジトリの根から）。未設定ならこのリポジトリの review-canvas.config.json（サンプル）
# 別のリポジトリの Storybook を並べるときは、そのリポジトリの設定ファイルを指す（outDir は設定ファイルのある場所から解く）
# REVIEW_CANVAS_CONFIG=../my-app/review-canvas.config.json
# ブランチ・コミットを読む git のリポジトリ。未設定ならこのリポジトリ
# REVIEW_GIT_DIR=../my-app

# ローカルの DynamoDB Local（このリポジトリの docker-compose.yml。`pnpm run docker:up`。ポート 8000）へ接続する設定（AWS SDK が自動で読む。creds はローカル用のダミー。新しい DynamoDB Local は英数字以外のキーを拒むため英数字だけにする）
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:8000
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=dummyAccessKeyId
AWS_SECRET_ACCESS_KEY=dummySecretAccessKey

# テーブル名（ほかのアプリと同じ DynamoDB Local を使っても混ざらないよう、名前で分ける）
COMMENT_TABLE_NAME=ReviewCanvasComment
