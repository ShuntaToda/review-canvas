{
  "name": "review-canvas",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook の画面をキャンバスに並べ、ピンを刺してコメントするレビュー用アプリ",
  "homepage": "https://github.com/ShuntaToda/review-canvas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShuntaToda/review-canvas.git"
  },
  "type": "module",
  "bin": {
    "review-canvas": "bin/review-canvas.mjs",
    "review-canvas-mcp": "bin/review-canvas-mcp.mjs"
  },
  "scripts": {
    "api": "tsx --tsconfig ./api/tsconfig.json",
    "prebuild": "pnpm run codegen",
    "build": "vite build --mode localhost",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "prebuild:deployed": "pnpm run codegen",
    "build:deployed": "vite build --mode deployed",
    "build:storybook": "pnpm --dir examples/sample-storybook run build-storybook --test",
    "check:deployed-bundle": "test -f dist-deployed/index.html && ! grep -rlF -e 'review-canvas.devAuth.name' -e '\"擬似ログイン\"' dist-deployed",
    "codegen": "openapi-typescript ./openapi.json -o src/generated/api-types.ts",
    "config:local": "node bin/copy-env.mjs",
    "config:schema": "pnpm run api ./api/handler/api/entrypoint/cli/generate-config-schema.ts",
    "db:refresh": "pnpm run config:local && pnpm run api ./api/handler/api/entrypoint/cli/refresh-local-ddb-tables.ts",
    "deploy": "pnpm --dir infra run deploy",
    "destroy": "pnpm --dir infra run destroy",
    "dev": "run-p dev:*",
    "dev:api": "pnpm run config:local && PORT=4101 tsx watch --tsconfig ./api/tsconfig.json ./api/handler/api/entrypoint/local/local.ts",
    "dev:bridge": "vite build --config vite.bridge.config.ts --watch",
    "dev:web": "vite --mode localhost",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait dynamodb-local",
    "fix": "run-s fix:*",
    "fix:format": "prettier --cache --write '**/*.{ts,tsx,css,json,md,yml,yaml,mjs}'",
    "fix:lint": "eslint --cache --max-warnings 0 --fix '**/*.{ts,tsx}' 'bin/*.mjs' 'eslint-rules/**/*.mjs'",
    "infra:test": "pnpm --dir infra run test",
    "infra:validate": "pnpm --dir infra run validate",
    "local": "pnpm run config:local && pnpm run build:bridge && pnpm run api ./api/handler/api/entrypoint/local/local.ts",
    "openapi:check": "pnpm run openapi:generate && git diff --exit-code openapi.json",
    "openapi:generate": "pnpm run api ./api/handler/api/entrypoint/cli/generate-openapi.ts",
    "prepare": "lefthook install || true",
    "pretest": "pnpm run codegen",
    "test": "vitest run",
    "pretest:small": "pnpm run codegen",
    "test:small": "vitest run --exclude '**/*.medium.test.ts'",
    "prevalidate": "pnpm run codegen",
    "validate": "run-p validate:*",
    "serve": "run-s build local",
    "sort": "sort-package-json",
    "synth": "pnpm --dir infra run synth",
    "check:all": "run-s validate infra:validate",
    "validate:cspell": "cspell '**/*.{ts,tsx,md,yml,yaml,json,mjs}' llms.txt --dot --cache --gitignore --no-progress",
    "validate:eslint": "eslint --cache --max-warnings 0 '**/*.{ts,tsx}' 'bin/*.mjs' 'eslint-rules/**/*.mjs'",
    "validate:knip": "knip",
    "validate:format": "prettier --cache -c '**/*.{ts,tsx,css,json,md,yml,yaml,mjs}'",
    "validate:schema": "pnpm run api ./api/handler/api/entrypoint/cli/generate-config-schema.ts --check",
    "validate:tsc": "run-p -c validate:tsc:*",
    "validate:tsc:api": "tsc -p api/tsconfig.json --noEmit",
    "validate:tsc:app": "tsc --noEmit",
    "validate:tsc:node": "tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.28.2",
    "@aws-lambda-powertools/logger": "2.33.1",
    "@aws-sdk/client-dynamodb": "3.1081.0",
    "@aws-sdk/client-s3": "3.1081.0",
    "@aws-sdk/lib-dynamodb": "3.1081.0",
    "@hono/node-server": "2.0.8",
    "@hono/zod-openapi": "1.4.0",
    "aws-jwt-verify": "5.2.1",
    "dayjs": "1.11.21",
    "hono": "4.12.28",
    "inversify": "6.2.2",
    "lucide-react": "1.23.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "4.1.2",
    "swr": "2.4.2",
    "ulid": "3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/react": "16.3.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "10.0.1",
    "dotenv": "16.6.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "4.0.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "29.1.1",
    "knip": "6.43.0",
    "lefthook": "2.1.10",
    "npm-run-all": "4.1.5",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.16",
    "prettier": "3.9.4",
    "sort-package-json": "2.15.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.63.0",
    "vite": "6.4.3",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "msw"
    ],
    "overrides": {
      "@smithy/types": "4.16.1",
      "oxc-resolver": "11.21.3"
    }
  }
}
