{
  "name": "review-canvas-infra",
  "version": "0.0.0",
  "private": true,
  "description": "review-canvas の AWS 構成（CDK のコンストラクト ReviewCanvas と、そのまま出せるスタック）と、ブランチの Storybook を置くスクリプト",
  "scripts": {
    "annotate-screen": "node -r esbuild-register scripts/annotate-screen.ts",
    "branch-storybooks": "node -r esbuild-register scripts/branch-storybooks.ts",
    "cdk": "cdk",
    "deploy": "pnpm --dir .. run build:deployed && REQUIRE_DIST=true cdk deploy --all",
    "deploy:no-build": "REQUIRE_DIST=true cdk deploy --all",
    "destroy": "cdk destroy --all",
    "diff": "cdk diff",
    "fix": "run-s fix:format fix:lint",
    "fix:format": "prettier --cache --write '**/*.{ts,json,md}' 'lib/cloudfront-functions/*.js'",
    "fix:lint": "eslint --cache --max-warnings 0 --fix '**/*.ts'",
    "publish-branch": "node -r esbuild-register scripts/branch-storybooks.ts publish",
    "screenshots": "node -r esbuild-register scripts/branch-storybooks.ts screenshots",
    "sort": "sort-package-json",
    "synth": "cdk synth",
    "test": "vitest run",
    "unpublish-branch": "node -r esbuild-register scripts/branch-storybooks.ts unpublish",
    "validate": "run-p validate:tsc validate:prettier validate:lint",
    "validate:lint": "eslint --cache --max-warnings 0 '**/*.ts'",
    "validate:prettier": "prettier --cache -c '**/*.{ts,json,md}' 'lib/cloudfront-functions/*.js'",
    "validate:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "aws-cdk": "2.1129.0",
    "esbuild": "0.28.1",
    "esbuild-register": "catalog:",
    "eslint": "9.39.4",
    "npm-run-all": "4.1.5",
    "playwright": "catalog:",
    "prettier": "3.9.4",
    "sort-package-json": "2.15.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.63.0",
    "vitest": "catalog:"
  },
  "main": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./scripts/branch-storybooks": "./scripts/branch-storybooks.ts"
  }
}
